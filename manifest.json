{
  "manifest_version": 3,
  "name": "Skellock",
  "description": "Ajoute un verrou local par code avant l'accès à Skello sur un ordinateur partagé.",
  "version": "1.1.0",
  "minimum_chrome_version": "102",
  "homepage_url": "https://github.com/keytrap-x86/skellock",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Verrouiller immédiatement Skello"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://*.skello.io/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "lock.html"
      ],
      "matches": [
        "https://*.skello.io/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  }
}
