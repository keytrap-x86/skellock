{
  "manifest_version": 3,
  "name": "SiteLock",
  "description": "Ajoute un verrou local par code avant l'accès aux sites choisis sur un ordinateur partagé.",
  "version": "2.0.0",
  "minimum_chrome_version": "105",
  "homepage_url": "https://github.com/keytrap-x86/skellock",
  "incognito": "not_allowed",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "SiteLock",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "lock.html"
      ],
      "matches": [
        "*://*/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob:; connect-src https: http:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  }
}
